[Unit]
Description=Publish a fresh kubeadm join token to SSM
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kube-lab-refresh-join
# kubeadm token create and upload-certs only read /etc/kubernetes; nothing here writes
# under /usr, /boot or /etc. Temp files (ssm_put) land in the private /tmp.
ProtectSystem=full
PrivateTmp=yes
# tmpfs rather than yes: the aws-cli snap must create $HOME/snap on every run.
ProtectHome=tmpfs
# No NoNewPrivileges: it blocks the AppArmor transitions snap-confine needs to start aws.
