# Generated per node by local.env in modules/cluster/bootstrap/main.tf: each
# template variable is the lower-case name of the shell variable it fills.
# Sourced as root by /etc/kube-lab/lib.sh, so every value is single-quoted, and the
# module's outputs.tf fails the plan if a value contains a single quote.
NODE_NAME='${node_name}'
NODE_ROLE='${node_role}'
IS_INIT_NODE='${is_init_node}'
PREVIOUS_CONTROL_PLANE='${previous_control_plane}'
EXPECTED_NODES='${expected_nodes}'
REGION='${region}'
SSM_PREFIX='${ssm_prefix}'
API_ENDPOINT='${api_endpoint}'
K8S_VERSION='${k8s_version}'
K8S_MINOR='${k8s_minor}'
CONTAINERD_VERSION='${containerd_version}'
CNI='${cni}'
CALICO_VERSION='${calico_version}'
CALICO_CRDS_SHA256='${calico_crds_sha256}'
CALICO_OPERATOR_SHA256='${calico_operator_sha256}'
CILIUM_VERSION='${cilium_version}'
CILIUM_CLI_VERSION='${cilium_cli_version}'
CILIUM_CLI_SHA256='${cilium_cli_sha256}'
HELM_ENABLED='${helm_enabled}'
HELM_VERSION='${helm_version}'
HELM_SHA256='${helm_sha256}'
