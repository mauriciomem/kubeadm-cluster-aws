# Filled in twice (see "Two templating passes" in docs/architecture.md):
# - Terraform's templatefile fills the single-dollar placeholders at plan time: names,
#   versions, CIDRs.
# - Double-dollar placeholders reach the node with a single dollar, and envsubst fills them
#   at boot (render_kubeadm_config in lib.sh): PRIVATE_IP, JOIN_TOKEN, CA_CERT_HASH and
#   CERT_KEY. That keeps join secrets out of Terraform.
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
bootstrapTokens:
  - token: "$${JOIN_TOKEN}"
    ttl: 24h0m0s
    usages: [signing, authentication]
    groups: [system:bootstrappers:kubeadm:default-node-token]
certificateKey: "$${CERT_KEY}"
localAPIEndpoint:
  advertiseAddress: "$${PRIVATE_IP}"
  bindPort: 6443
nodeRegistration:
  name: ${node_name}
  criSocket: unix:///run/containerd/containerd.sock
  # Explicit, so the serving certificate carries the VPC IP the CSR approver expects.
  kubeletExtraArgs:
    - name: node-ip
      value: "$${PRIVATE_IP}"
%{ if schedulable_control_plane ~}
  # No workers: let workloads run on the control plane.
  taints: []
%{ endif ~}
timeouts:
  # etcd and the API server can start slowly on burstable instances.
  controlPlaneComponentHealthCheck: 8m0s
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: v${k8s_version}
clusterName: ${cluster_name}
controlPlaneEndpoint: "${api_endpoint}"
apiServer:
  # kubeadm adds the controlPlaneEndpoint host on its own; listed so you can see it.
  certSANs:
    - "${api_host}"
networking:
  podSubnet: ${pod_cidr}
  serviceSubnet: ${service_cidr}
  dnsDomain: cluster.local
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
# The kubeadm default, stated so you can see it matches containerd's SystemdCgroup = true.
cgroupDriver: systemd
# Kubelets ask the cluster CA for their serving certificate instead of signing their own, so
# anything that talks to a kubelet can verify it. Until kubelet-csr-approver approves the
# CSR, the kubelet has no serving certificate and kubectl logs, exec and port-forward fail.
serverTLSBootstrap: true
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
# The default on Linux, stated so you know which mode you're debugging.
mode: iptables
