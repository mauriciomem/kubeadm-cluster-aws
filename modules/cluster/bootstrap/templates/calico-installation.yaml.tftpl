apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  calicoNetwork:
    # Always-on VXLAN works with EC2 source/destination checks left enabled.
    bgp: Disabled
    ipPools:
      - name: default-ipv4-ippool
        cidr: ${pod_cidr}
        blockSize: 26
        encapsulation: VXLAN
        natOutgoing: Enabled
        nodeSelector: all()
---
apiVersion: operator.tigera.io/v1
kind: APIServer
metadata:
  name: default
spec: {}
